# Ambiente virtual (recriado com: pip install -r requirements.txt)
.venv/

# Arquivos gerados automaticamente pelo Python e pelo Jupyter
__pycache__/
.ipynb_checkpoints/

# Modelos treinados (arquivos grandes; são recriados rodando os notebooks)
modelos/

